# Google Sheets — isi setelah Hera selesai & spreadsheet "Data Posyandu Kaltim - Master" siap
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Login dashboard (sementara — nanti diganti mekanisme yang lebih aman)
DASHBOARD_USERNAME=buvio
# Isi ini dengan HASH SHA-256 dari password, bukan passwordnya langsung:
# node -e "console.log(require('crypto').createHash('sha256').update('password_asli').digest('hex'))"
DASHBOARD_PASSWORD_HASH=

# WAJIB diisi string acak panjang — dipakai buat menandatangani cookie sesi
# login, tanpa ini siapa pun bisa bikin cookie palsu & masuk tanpa password.
# Cara bikin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
